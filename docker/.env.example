# NovaCloudEdu 环境变量配置模板
# 复制此文件为 .env 并修改密码
# 警告：.env 文件包含敏感信息，不要提交到 Git

# ========== 数据库 ==========
POSTGRES_DB=novacloudedu
POSTGRES_USER=nova
POSTGRES_PASSWORD=changeme_postgres_password_123
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_PASSWORD=changeme_redis_password_123
REDIS_PORT=6379

# ========== Neo4j ==========
# 格式: username/password
NEO4J_AUTH=neo4j/changeme_neo4j_password_123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ========== Elasticsearch ==========
ES_PORT=9200
ES_TRANSPORT_PORT=9300

# ========== OnlyOffice ==========
ONLYOFFICE_PORT=9980
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=changeme_onlyoffice_secret_1234567

# ========== Gotenberg ==========
GOTENBERG_PORT=3000
GOTENBERG_CPU_LIMIT=1
GOTENBERG_MEM_LIMIT=1G
GOTENBERG_CPU_RESERVE=0.5
GOTENBERG_MEM_RESERVE=512M

# ========== OnlyOffice 资源限制 ==========
ONLYOFFICE_CPU_LIMIT=2
ONLYOFFICE_MEM_LIMIT=2G
ONLYOFFICE_CPU_RESERVE=0.5
ONLYOFFICE_MEM_RESERVE=1G

# ========== 应用服务 ==========
BACKEND_PORT=8080
PPT_SERVICE_PORT=8100

# ========== OSS (阿里云) - 可选 ==========
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_DOMAIN=

# ========== 实时音视频 ==========
RTC_WS_PORT=8300
SRS_RTMP_PORT=1935
SRS_HTTP_PORT=8085
SRS_API_PORT=1985
TURN_REALM=novacloudedu.com
TURN_USER=nova
TURN_PASSWORD=changeme_turn_password
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP=7881
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
