# =================================================================
# NovaCloudEdu 全局环境变量配置模板
# 复制此文件为 .env 并修改密码/密钥
# 警告：.env 文件包含敏感信息，不要提交到 Git
#
# 这些变量同时被 docker-compose.yml 和 Spring Boot application.yml 使用
# Spring Boot 通过 ${ENV_VAR:default} 语法直接读取环境变量
# =================================================================

# ========== 数据库 (PostgreSQL) ==========
DB_NAME=novacloudedu
DB_USERNAME=nova
DB_PASSWORD=changeme_postgres_password_123
DB_PORT=5432

# ========== Redis ==========
REDIS_PASSWORD=changeme_redis_password_123
REDIS_PORT=6379

# ========== Neo4j ==========
NEO4J_AUTH=neo4j/changeme_neo4j_password_123
NEO4J_PASSWORD=changeme_neo4j_password_123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ========== Elasticsearch ==========
ES_PORT=9200
ES_TRANSPORT_PORT=9300

# ========== JWT ==========
JWT_SECRET=NovaCloudEduSecretKey123456789012345678901234567890

# ========== 邮件 SMTP ==========
MAIL_USERNAME=
MAIL_PASSWORD=

# ========== 管理员邮件通知 ==========
ADMIN_EMAIL_ENABLED=true
ADMIN_EMAIL_RECIPIENTS=admin@example.com

# ========== SMS 短信 ==========
SMS_URL=
SMS_TOKEN=

# ========== 阿里云 OSS ==========
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=novacloudedu
ALIYUN_OSS_DOMAIN=

# ========== 阿里云 NLS (语音) ==========
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=

# ========== AI — DashScope (通义千问) ==========
DASHSCOPE_API_KEY=

# ========== AI — 可选模型提供商 ==========
OPENAI_ENABLED=false
OPENAI_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
MOONSHOT_ENABLED=false
MOONSHOT_API_KEY=
ZHIPU_ENABLED=false
ZHIPU_API_KEY=
SILICONFLOW_ENABLED=false
SILICONFLOW_API_KEY=
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=

# ========== 百度 OCR ==========
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ========== 书籍内容加密 ==========
BOOK_ENCRYPTION_ENABLED=false
BOOK_ENCRYPTION_KEY=NovaCloudEduBookKey1

# ========== Tavily Search (PPT Agent) ==========
TAVILY_API_KEY=

# ========== PPT Agent ==========
PPT_AGENT_CONCURRENCY=3
PPT_AGENT_QUALITY_THRESHOLD=65
PPT_AGENT_MAX_REPAIR_ROUNDS=2
PPT_AGENT_SLIDE_SCORE_THRESHOLD=60
PPT_AGENT_IMAGE_SEARCH_ENABLED=false

# ========== OnlyOffice ==========
ONLYOFFICE_PORT=9980
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=changeme_onlyoffice_secret_1234567

# ========== Gotenberg ==========
GOTENBERG_PORT=3000
GOTENBERG_CPU_LIMIT=1
GOTENBERG_MEM_LIMIT=1G
GOTENBERG_CPU_RESERVE=0.5
GOTENBERG_MEM_RESERVE=512M

# ========== OnlyOffice 资源限制 ==========
ONLYOFFICE_CPU_LIMIT=2
ONLYOFFICE_MEM_LIMIT=2G
ONLYOFFICE_CPU_RESERVE=0.5
ONLYOFFICE_MEM_RESERVE=1G

# ========== Docker Socket ==========
# macOS Docker Desktop: /Users/<username>/.docker/run/docker.sock
# Linux: /var/run/docker.sock
DOCKER_SOCK_PATH=/var/run/docker.sock

# ========== 应用服务端口 ==========
BACKEND_PORT=8080
PPT_SERVICE_PORT=8100
TYPST_SERVICE_PORT=8200
SERVER_BASE_URL=http://localhost:8080

# ========== 视频转码 ==========
FFMPEG_PATH=ffmpeg
HLS_TIME=10

# ========== 实时音视频 ==========
# 后端在宿主机/IDE 中运行时使用 http://host.docker.internal:8080；
# 后端也由同一个 compose 启动时可使用默认值 http://backend:8080。
JAVA_BACKEND_URL=http://backend:8080
RTC_WS_PORT=8300
SRS_RTMP_PORT=1935
SRS_HTTP_PORT=8085
SRS_API_PORT=1985
TURN_REALM=novacloudedu.com
TURN_USER=nova
TURN_PASSWORD=changeme_turn_password
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP=7881
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
