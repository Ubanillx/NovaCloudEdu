# ============================================
# NovaCloudEdu Backend 环境变量配置示例
# ============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 填写实际的配置值
# 3. 确保 .env 文件已添加到 .gitignore，避免泄露敏感信息
# ============================================

# --------------------------------------------
# AI 配置 - 阿里云灵积平台 (DashScope)
# --------------------------------------------
# 获取API Key: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM 模型配置 (可选, 默认: qwen-turbo)
# 可选值: qwen-turbo, qwen-plus, qwen-max, qwen-max-longcontext
DASHSCOPE_LLM_MODEL=qwen-turbo

# Embedding 模型配置 (可选, 默认: text-embedding-v2)
# 可选值: text-embedding-v1, text-embedding-v2
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# --------------------------------------------
# JWT 配置
# --------------------------------------------
# JWT 密钥 (可选, 默认使用内置值)
# 建议在生产环境中使用强密钥
JWT_SECRET=your-jwt-secret-key-here

# JWT 过期时间 (毫秒, 可选, 默认: 86400000 即24小时)
JWT_EXPIRATION=86400000

# --------------------------------------------
# 数据库配置 - PostgreSQL
# --------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/NovaCloudEdu
SPRING_DATASOURCE_USERNAME=NovaCloudEdu
SPRING_DATASOURCE_PASSWORD=your-database-password-here

# --------------------------------------------
# 缓存配置 - Redis
# --------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your-redis-password-here
SPRING_DATA_REDIS_DATABASE=0

# --------------------------------------------
# 知识图谱数据库配置 - Neo4j
# --------------------------------------------
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=your-neo4j-password-here

# --------------------------------------------
# 阿里云OSS配置
# --------------------------------------------
# 获取AccessKey: https://ram.console.aliyun.com/manage/ak
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id-here
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret-here
ALIYUN_OSS_BUCKET_NAME=novacloudedu
ALIYUN_OSS_DOMAIN=https://your-cdn-domain-here.com

# --------------------------------------------
# 短信服务配置
# --------------------------------------------
SMS_URL=https://your-sms-service-url-here
SMS_QUERY_URL=https://your-sms-query-url-here
SMS_TOKEN=your-sms-token-here
SMS_APP_NAME=智云星课
SMS_EXPIRE_MINUTES=5

# --------------------------------------------
# 应用配置
# --------------------------------------------
# 应用环境: dev, prod
SPRING_PROFILES_ACTIVE=dev

# 服务器端口 (可选, 默认: 8080)
SERVER_PORT=8080
