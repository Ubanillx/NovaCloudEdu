# Copy this file to /etc/default/novacloudedu-backend and adjust it for your server.
# The systemd unit loads it automatically if present.

SPRING_PROFILES_ACTIVE=prod
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=novacloudedu
DB_USERNAME=nova
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
ES_HOST=127.0.0.1
ES_PORT=9200
JVM_OPTS=-server -Xms512m -Xmx1024m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/home/debian/NovaCloudEdu/backend/logs/heapdump.hprof -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
